// BuildBridge — Prisma schema
//
// This is the first real slice: manual contractor entry (by admin), real
// developer accounts, and a quote-request flow that fires an email.
//
// Deliberately NOT in this schema yet: Supplier, Review (as a submittable
// entity), InteriorDesigner. Those come once this slice is proven — adding
// them now would mean guessing at shapes we don't have real usage for yet.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  
}

// ---------------------------------------------------------------------------
// Contractor
// ---------------------------------------------------------------------------
// Added by you (admin) by hand for this slice. `verificationStatus` is what
// makes the "Verified" badge mean something — it's a real gate you control,
// not decoration. Don't mark PENDING contractors as VERIFIED until you've
// actually checked the license number against Maharashtra's contractor
// registry (or whichever state's registry applies).
//
// `rating` and `reviewCount` are plain fields you set by hand for now. Once
// real developers can submit reviews tied to real projects, these should
// become computed aggregates (avg of Review.rating, count of Review rows)
// instead of values anyone can just set. Flagging that now so it isn't
// forgotten later.

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

// Paid listing tier. Everyone starts on LISTED (free) — this exists now so
// the badge UI and contractor dashboard have a real field to read from, but
// billing doesn't actually start until the trial period ends. Don't wire up
// Razorpay or any charge logic against this yet; it's schema-first on
// purpose so tier display and payment can be built independently.
enum ContractorTier {
  LISTED    // free — default for everyone during the trial period
  PLUS
  PRO
}

model Contractor {
  id     String @id @default(cuid())
  name   String
  slug   String @unique // used in profile URLs — e.g. /contractors/kunal-raut-constructions

  // Logo shown on browse cards and the profile header. Stored as a full
  // URL pointing at Vercel Blob storage — nothing about images lives in
  // this database except the URL itself. Optional: a contractor with no
  // logo yet falls back to their initials, same as before this feature
  // existed — never block anything on a logo being present.
  logoUrl String?

  // Location
  city   String
  area   String // e.g. "Thane", "Andheri West" — the neighborhood-level filter

  // Trade / work type — stored as a simple string array for this slice.
  // If the list of trades needs its own metadata later (icons, descriptions),
  // split this into a proper WorkType model with a join table. Not needed yet.
  tradeTypes String[]

  // Licensing & verification
  licenseNumber      String              @unique
  verificationStatus VerificationStatus  @default(PENDING)
  verifiedAt         DateTime?

  // Paid tier — see ContractorTier comment above. Defaults to free for
  // everyone during the trial period.
  tier ContractorTier @default(LISTED)

  // Data-sharing consent: whether this contractor has agreed to have their
  // business data (not developer/quote data) shared with material
  // suppliers. Two fields, not one boolean — dataSharingConsentAt records
  // *when* consent was given, which matters if consent language changes
  // later and existing consents need to be re-confirmed. Both null means
  // "never asked / not consented" — never assume consent by default.
  dataSharingConsent   Boolean   @default(false)
  dataSharingConsentAt DateTime?

  // Track record — set by hand when you add the contractor, based on what
  // they tell you / what you can confirm. Not yet derived from real Project
  // rows submitted through the app.
  yearsInBusiness    Int?
  teamSizeMin        Int?
  teamSizeMax        Int?
  gstRegistered      Boolean @default(false)
  insuranceCoverLakh Int?    // insurance cover in ₹ lakh, if disclosed

  // Rating — see note above. Plain fields for now.
  rating      Float @default(0)
  reviewCount Int   @default(0)

  // Contact — the number a developer's quote request notifies. Not shown
  // publicly on the profile; only released to a developer via a quote
  // request, matching the original "provide your number, they call you"
  // flow.
  phone String

  // Login credential as of the contractor dashboard — required and unique
  // now, unlike the Developer model's nullable early days. There are no
  // real contractor accounts yet (only admin-entered placeholders), so no
  // backfill/migration concern here.
  email        String  @unique
  passwordHash String?
  // Nullable on purpose: an admin-entered placeholder contractor has no
  // password until they actually sign up and claim/set one. Treat a null
  // passwordHash as "no dashboard account yet" — never let a contractor
  // log in until this is set.

  // Email verification & password reset — same one-time-token pattern as
  // Developer, kept as separate token fields so a live reset link can't
  // also be replayed to verify an email.
  emailVerified               Boolean   @default(false)
  emailVerifyToken            String?   @unique
  emailVerifyTokenExpiresAt   DateTime?
  passwordResetToken          String?   @unique
  passwordResetTokenExpiresAt DateTime?

  bio String? // short "about" text for the profile page

  projects      Project[]
  quoteRequests QuoteRequest[]
  projectAlerts ProjectPostAlert[]
  shortlistedBy ShortlistedContractor[]
  siteVisits    SiteVisit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city, area])
  @@index([tradeTypes])
  @@index([verificationStatus])
}

// ---------------------------------------------------------------------------
// Project
// ---------------------------------------------------------------------------
// A contractor's completed-project history, shown on their profile. For this
// slice, you (admin) enter these by hand alongside the contractor — there's
// no flow yet for a contractor or developer to submit one themselves. That's
// fine: the profile page needs real rows to read from, and manual entry is
// the honest reflection of where "verification" actually stands right now.

model Project {
  id           String  @id @default(cuid())
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  title            String
  developerName    String? // the developer/client this was built for — omit if they asked not to be named
  projectType      String? // e.g. "Residential, 18 floors"
  completedYear    Int?

  squareFeet       Int?    // built-up area in sq ft
  elevationFloors  Int?    // number of floors, e.g. 18 for a "G+18" building

  // Timeline as committed to the developer vs how long the project actually
  // took, both in months. Committed comes from what the contractor promised
  // up front; actual is filled in once the project wrapped. Either can be
  // left blank if unknown — this is admin-entered from what the contractor
  // reports, not independently verified.
  committedDurationMonths Int?
  actualDurationMonths    Int?

  // Photos of the completed project — stored as an array of Vercel Blob
  // URLs, in the order they should be displayed. A project can have zero
  // photos (the profile page falls back to the existing placeholder
  // gradient block) or several.
  imageUrls String[] @default([])

  // Review — admin-entered ONLY, never a self-service submission flow.
  // Per the actual process: the contractor's founder personally collects
  // this from the developer named above after the project wraps, then
  // types it in here via the admin form. There is deliberately no public
  // "submit a review" endpoint — that would let anyone claim to be a past
  // client, which defeats the whole point of this being a real, sourced
  // review. One review per project (not per contractor) is the natural
  // fit: reviewRating/reviewText are nullable fields on the project they
  // belong to, not a separate model with its own relation, since there's
  // no scenario where a project has more than one review or a review
  // exists without a project.
  reviewRating Int?    // 1-5, validated in the admin API route (Prisma itself doesn't constrain this)
  reviewText   String? // the developer's own words, typed in by admin
  reviewedAt   DateTime? // when the review was collected/entered — null if reviewRating is null

  createdAt DateTime @default(now())

  @@index([contractorId])
}
// ---------------------------------------------------------------------------
// Developer
// ---------------------------------------------------------------------------
// Real accounts. Password hash lives here for credentials-based auth via
// NextAuth. If you later want Google/phone-OTP sign-in instead of email +
// password, this model extends cleanly — NextAuth's adapter pattern doesn't
// require reshaping this table.

model Developer {
  id           String @id @default(cuid())
  name         String
  email        String @unique
  passwordHash String

  phone String? // required at signup going forward; stays nullable so accounts created before this change don't break

  // Email verification — set on signup, cleared once the link is clicked
  // (or a password reset is completed, which proves the same thing).
  // Login is NOT blocked on this being true, so a developer can always get
  // in to browse, shortlist and resend the link. But sending a quote
  // request or posting a project IS: see src/lib/require-verified-email.ts.
  // Those are the actions that email contractors or admin on the
  // developer's behalf, so they need a real, reachable address.
  emailVerified              Boolean   @default(false)
  emailVerifyToken           String?   @unique
  emailVerifyTokenExpiresAt  DateTime?

  // Password reset — same one-time-token pattern as email verification,
  // kept as separate fields (not reused) so a live password-reset link
  // can't also be replayed to verify an email, or vice versa.
  passwordResetToken          String?   @unique
  passwordResetTokenExpiresAt DateTime?

  quoteRequests QuoteRequest[]
  projectPosts  ProjectPost[]
  shortlist     ShortlistedContractor[]
  siteVisits    SiteVisit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// QuoteRequest
// ---------------------------------------------------------------------------
// The core mechanic of this whole slice. Creating one of these is what fires
// the notification email. Every request lands as PENDING; from there the
// CONTRACTOR moves it along from their dashboard via
// PATCH /api/quote-requests/[id]/status, and each change emails the
// developer. The allowed transitions live in src/lib/quote-status.ts, not
// here — Prisma can't express "only forward moves", so don't assume the
// schema alone protects this.
//
//   PENDING   → CONTACTED ("Accept — I'll be in touch") | QUOTED | DECLINED
//   CONTACTED → QUOTED | DECLINED
//   QUOTED    → (final)
//   DECLINED  → (final)
//
// CONTACTED is the "accepted" state. It kept its original name rather than
// being renamed to ACCEPTED so existing rows and the baseline migration
// don't need rewriting — the UI labels it "Accepted".

enum QuoteRequestStatus {
  PENDING
  CONTACTED
  QUOTED
  DECLINED
}

model QuoteRequest {
  id String @id @default(cuid())

  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  developerId String
  developer   Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)

  projectType    String
  location       String
  budgetRangeLabel String // e.g. "₹1 Cr – ₹3 Cr" — stored as the label shown, not a numeric range, since this is what the notification email should read naturally
  details        String
  contactPhone   String // developer's number, captured at request time even if it's already on their account — keeps the record self-contained

  status QuoteRequestStatus @default(PENDING)
  statusUpdatedAt DateTime? // when the contractor last changed `status` — null while still PENDING

  emailSentAt DateTime? // null if the notification email failed — lets you spot silently-dropped requests

  messages Message[]

  // Unread tracking for the in-app thread, one pair of fields per side
  // (there are only ever two parties, so this is simpler than a separate
  // "read receipts" table). A message is unread for a side if it was sent
  // by the OTHER side after that side's lastReadAt (or ever, if null).
  // lastReadAt is bumped whenever that party loads the thread.
  //
  // notifiedAt throttles "you have a new message" emails: we only email a
  // side if we haven't already emailed them since they last read the
  // thread. So a burst of ten messages produces one email, not ten, and
  // the next email only goes out once they've come back and read it.
  developerLastReadAt  DateTime?
  contractorLastReadAt DateTime?
  developerNotifiedAt  DateTime?
  contractorNotifiedAt DateTime?

  createdAt DateTime @default(now())

  @@index([contractorId])
  @@index([developerId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// ProjectPost / ProjectPostAlert
// ---------------------------------------------------------------------------
// A second, more general intake path alongside QuoteRequest. Where a
// QuoteRequest targets one specific contractor a developer already found
// via browse, a ProjectPost is a developer describing a project with NO
// contractor picked yet — closer to "tell us what you need" than "contact
// this company". It is never shown publicly and never auto-matched to
// contractors; it lands with admin (same "you get an email" pattern as
// QuoteRequest) and stays admin-only until a human decides who should hear
// about it.
//
// ProjectPostAlert is the deliberate, manual link between one ProjectPost
// and the specific contractor(s) admin chooses to notify. This is the PRO
// perk: alerting is restricted to tier === PRO contractors at the API
// layer (not enforced by the schema itself — Prisma has no way to express
// "this foreign key must point at a row where tier = PRO" — so
// src/app/api/admin/project-posts/[id]/alert/route.ts is where that rule
// actually lives; don't assume the schema alone protects this).
model ProjectPost {
  id String @id @default(cuid())

  developerId String
  developer   Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)

  projectType      String
  location         String
  budgetRangeLabel String
  details          String
  contactPhone     String // same reasoning as QuoteRequest.contactPhone — self-contained record

  status ProjectPostStatus @default(NEW)

  emailSentAt DateTime? // the "admin was notified" email, not a contractor alert

  alerts ProjectPostAlert[]

  createdAt DateTime @default(now())

  @@index([developerId])
  @@index([status])
}

enum ProjectPostStatus {
  NEW // just submitted, admin hasn't actioned it
  MATCHED // admin has alerted at least one contractor
  CLOSED // admin considers this done (contractor engaged, or project no longer active) — set by hand, nothing automatic closes this yet
}

model ProjectPostAlert {
  id String @id @default(cuid())

  projectPostId String
  projectPost   ProjectPost @relation(fields: [projectPostId], references: [id], onDelete: Cascade)

  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  // When the alert was actually sent (email + dashboard both become
  // visible at the same moment — there's no separate "seen" state yet,
  // this timestamp IS what makes it show in the contractor's dashboard).
  alertedAt DateTime @default(now())

  // A contractor can be alerted about the same project more than once in
  // theory (admin re-sends), so this is NOT unique on
  // [projectPostId, contractorId] — duplicates are a deliberate non-issue,
  // not a bug, if that ever happens.
  @@index([projectPostId])
  @@index([contractorId])
}

// ---------------------------------------------------------------------------
// ShortlistedContractor
// ---------------------------------------------------------------------------
// A developer's saved/shortlisted contractor, with an optional private
// note. Unlike QuoteRequest (which fires a real notification to the
// contractor), shortlisting is entirely private to the developer — the
// contractor is never notified and never knows they've been shortlisted.
// This is deliberately unique on [developerId, contractorId]: shortlisting
// the same contractor twice should update the existing row (and its note),
// not create a duplicate — the UI ("save"/"unsave" toggle) treats this as
// a single on/off state per developer-contractor pair, not a log of every
// time someone clicked save.
model ShortlistedContractor {
  id String @id @default(cuid())

  developerId String
  developer   Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)

  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  // Private to the developer — never shown to the contractor or anyone
  // else. Nullable: saving a contractor doesn't require writing a note.
  note String?

  createdAt DateTime @default(now())

  @@unique([developerId, contractorId])
  @@index([developerId])
  @@index([contractorId])
}

// ---------------------------------------------------------------------------
// Message
// ---------------------------------------------------------------------------
// Optional in-app thread on a QuoteRequest. This does NOT replace the
// existing "developer sees contractor's email/phone, contractor sees
// developer's email/phone" reveal — that stays exactly as-is. This is an
// ADDITIONAL channel: a contractor or developer can reply in-app instead
// of switching to email, which is what makes real engagement visible to
// admin (message counts, whether a thread ever started) in a way raw
// QuoteRequest counts never could. One QuoteRequest can have many
// Messages; there's no separate "Thread" model since the QuoteRequest
// itself already uniquely identifies the developer-contractor pair a
// conversation belongs to.
//
// senderRole distinguishes who sent it without needing two nullable
// foreign keys (developerId-or-null, contractorId-or-null) — the sender's
// actual identity is recoverable from the QuoteRequest's own
// developerId/contractorId plus this role, so storing it directly here
// would be redundant.
model Message {
  id String @id @default(cuid())

  quoteRequestId String
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)

  senderRole MessageSenderRole
  body       String

  createdAt DateTime @default(now())

  @@index([quoteRequestId])
}

enum MessageSenderRole {
  DEVELOPER
  CONTRACTOR
}

// ---------------------------------------------------------------------------
// SiteVisit
// ---------------------------------------------------------------------------
// A developer asking to see a contractor's completed projects in person,
// the most direct way for them to judge the quality of the work before
// hiring. Started from the contractor's public profile, independent of any
// QuoteRequest: checking someone's work usually comes BEFORE asking them
// for a price.
//
// Flow: the developer picks up to 5 of the contractor's listed projects
// (3 minimum, or all of them if the contractor lists fewer than 3), offers
// 3 date/time options, and the contractor is emailed. The contractor
// confirms one of the offered times and adds a meeting point/address
// (Project rows don't store addresses), or declines. Either side can
// cancel. Confirmation emails both sides a calendar invite.
//
// projectIds is a plain array rather than a join table: it's a small,
// fixed-at-request-time list, and the API checks every id belongs to this
// contractor when the visit is created. If a contractor later deletes one
// of those projects, readers simply drop the missing id.
enum SiteVisitStatus {
  REQUESTED // waiting on the contractor
  CONFIRMED // contractor picked a time; confirmedSlot is set
  DECLINED  // contractor said no
  CANCELLED // either side called it off after requesting/confirming
}

model SiteVisit {
  id String @id @default(cuid())

  developerId String
  developer   Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)

  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  projectIds    String[]
  proposedSlots DateTime[] // exactly 3, validated in the API
  confirmedSlot DateTime?  // one of proposedSlots, set on CONFIRMED

  status SiteVisitStatus @default(REQUESTED)

  developerNote String? // anything the developer wants the contractor to know
  contactPhone  String  // developer's number for the day, captured at request time
  meetingPoint  String? // set by the contractor on confirm: where to meet / site address
  responseNote  String? // contractor's reason on decline, or extra detail on confirm
  cancelledBy   MessageSenderRole? // which side cancelled, if CANCELLED

  requestEmailSentAt DateTime? // null if the "new visit request" email to the contractor failed

  // In-app notifications. Whoever acted last (lastActionBy, at
  // lastActionAt) has obviously seen the change; the OTHER side hasn't
  // until they next open their dashboard, which bumps their seenAt. A
  // visit counts as "new" for a side when the other side acted after that
  // side's seenAt. Feeds the Nav badge (via /api/messages/unread) and the
  // "New" label on dashboard cards. Emails still go out as well; this is
  // for people who don't check email, and for while Resend can only email
  // the account owner.
  lastActionAt     DateTime           @default(now())
  lastActionBy     MessageSenderRole?
  developerSeenAt  DateTime?
  contractorSeenAt DateTime?

  createdAt   DateTime  @default(now())
  respondedAt DateTime? // when the contractor confirmed/declined

  @@index([developerId])
  @@index([contractorId])
  @@index([status])
}
